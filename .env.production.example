APP_NAME="PSU Attendance"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.example
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=REPLACE_WITH_PRODUCTION_DATABASE
DB_USERNAME=REPLACE_WITH_DATABASE_USER
DB_PASSWORD=
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null
CACHE_STORE=database
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
MAIL_MAILER=smtp
MAIL_HOST=REPLACE_WITH_SMTP_HOST
MAIL_PORT=587
MAIL_SCHEME=smtp
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=REPLACE_WITH_VERIFIED_SENDER
MAIL_FROM_NAME="PSU Attendance"
ATTENDANCE_GRACE_MINUTES=15
ATTENDANCE_EARLY_MINUTES=15
ATTENDANCE_LOOKBACK_DAYS=7
VITE_APP_NAME="${APP_NAME}"